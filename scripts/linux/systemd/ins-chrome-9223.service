[Unit]
Description=INS Chrome CDP 9223 (headful under Xvfb, US proxy)
After=ins-xvfb.service ins-mihomo.service
Requires=ins-xvfb.service

[Service]
Type=simple
User=ubuntu
Environment=DISPLAY=:99
WorkingDirectory=/opt/maxinfluencer
ExecStart=/usr/bin/google-chrome --remote-debugging-port=9223 --remote-allow-origins=* --user-data-dir=/opt/maxinfluencer/.chrome-cdp-9223 --no-first-run --no-default-browser-check --disable-dev-shm-usage --window-size=1280,800 --proxy-server=http://127.0.0.1:7897 --proxy-bypass-list=<-loopback> about:blank
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
