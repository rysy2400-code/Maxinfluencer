{
	# 直接访问 https://IP 时浏览器不发送 SNI，这里指定默认 SNI 为 IP，
	# 使无 SNI 的 TLS 连接也能匹配到 IP 的内置证书并完成跳转
	default_sni 152.32.185.48
	log {
		output file C:\caddy\caddy.log
		level INFO
	}
}

# maxinai.xyz 反向代理配置（Caddy 自动申请/续期 HTTPS 证书）
#
# 前置条件：
#   1. DNS 已添加 A 记录：@ 和 www 都指向 152.32.185.48
#   2. Next.js 已改到 3000 端口运行（部署时设置 WEB_PORT=3000 后跑 deploy-web.ps1）
#   3. Windows 防火墙已放行 80 / 443 入站
#
# 启动：caddy start（或注册为 Windows 服务 caddy run）

maxinai.xyz, www.maxinai.xyz {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# 旧 IP 访问自动跳转到域名（兼容历史书签/外链）
# HTTPS 用 Caddy 内置 CA 的临时证书（Let's Encrypt 不签发纯 IP 证书），
# 浏览器会提示一次证书不受信，确认后即跳转到 https://maxinai.xyz
https://152.32.185.48 {
	tls internal
	redir https://maxinai.xyz{uri} permanent
}

http://152.32.185.48 {
	redir https://maxinai.xyz{uri} permanent
}
