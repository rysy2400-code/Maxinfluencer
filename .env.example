# Copy to .env.local (local) or set machine env on Windows crawler VMs.
# Never commit real secrets. .env / .env.local are gitignored.

# Crawler deploy (deploy-crawler.ps1): work-live Redis (Upstash uses rediss://)
# CRAWLER_REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_HOST:6379
# Or use REDIS_URL for the same value.

# Web：广告主登录 JWT（至少 16 字符随机串；生产必填）
# AUTH_JWT_SECRET=

# Cookie Secure：生产默认 true；本地 HTTP 可设为 0
# AUTH_COOKIE_SECURE=0

# Crawler 运维台远程操作（仅控制面需要）
# CRAWLER_SSH_KEY_PATH=C:/ProgramData/ssh/maxin_crawler_key
# CRAWLER_SSH_USER=Administrator
# CRAWLER_SSH_PORT=22
# CRAWLER_SSH_TIMEOUT_MS=600000

# 执行心跳（派单控制器）整体超时看门狗：单次 tick 超过该时长即报错退出，
# 由下一轮计划任务接管，避免 LLM/DB 挂死导致长时间不派单。默认 900000（15 分钟）
# EXECUTION_HEARTBEAT_TIMEOUT_MS=900000

# DeepSeek LLM 默认超时（调用方未显式传 timeoutMs 时的兜底；传 0 表示不超时）
# 非流式单次生成默认 120000（2 分钟），流式长内容默认 180000（3 分钟）
# DEEPSEEK_LLM_TIMEOUT_MS=120000
# DEEPSEEK_LLM_STREAM_TIMEOUT_MS=180000

# Crawler 飞书群机器人告警（只发送故障/降级/恢复通知）
# FEISHU_CRAWLER_ALERT_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_ME
# FEISHU_CRAWLER_ALERT_SECRET=
# CRAWLER_OPS_BASE_URL=https://YOUR_CONTROL_PLANE_HOST
